# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# engine source checkout used by `bun run engine:setup`
.engine-src/

# the sliceable corpus — generated by `bun scripts/build-corpus.mjs <checkout>`;
# 30+ MB of YAML lives in checkouts/CDN, not git (docs/artifact-distribution.md).
# corpus.lock.json (tracked) pins the commit; deploys regenerate from it.
# ledger.json is the ONE tracked exception: it is the certification ledger
# every serving surface gates against — a clone must fail closed to the
# ledger's certified set, not open because the ledger was ungenerated.
public/corpus/*
!public/corpus/ledger.json
.corpus-src/

# local editor / agent config
.claude/

# misc
.DS_Store
*.tsbuildinfo
*.log
scratch/
.vercel
